{
  "name": "llm-proxy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && tsc -p tsconfig.json",
    "build:ui": "vite build",
    "native:rebuild": "npm install-scripts approve better-sqlite3 && npm rebuild better-sqlite3",
    "prestart": "npm run native:rebuild",
    "start": "node dist/server.js",
    "predev": "npm run native:rebuild",
    "dev": "tsx src/server.ts",
    "verify": "npm run native:rebuild && npm run build && node scripts/verify.mjs && node scripts/verify-turn.mjs && tsx scripts/verify-viewer.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@monaco-editor/react": "^4.6.0",
    "@uiw/react-json-view": "^2.0.0-alpha.5",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "highlight.js": "^11.11.1",
    "monaco-editor": "0.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
