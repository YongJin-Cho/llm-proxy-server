{
  "name": "llm-proxy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && tsc -p tsconfig.json",
    "build:ui": "vite build",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "verify": "npm install-scripts approve better-sqlite3 && npm rebuild better-sqlite3 && npm run build && node scripts/verify.mjs && node scripts/verify-turn.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
